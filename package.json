{
  "name": "LLMelt",
  "version": "0.1.0",
  "author": "Justin Laponder",
  "description": "LLMelt - ChatGPT, Claude, Gemini, Codex, Antigravity en lokale LLM's in één app",
  "repository": {
    "type": "git",
    "url": "https://github.com/JustMLC4real/LLMelt.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:antigravity": "node scripts/test-antigravity-integration.mjs",
    "test:chatgpt": "node scripts/test-chatgpt-integration.mjs",
    "test:chatgpt:catalog": "set CHATGPT_CATALOG_ONLY=1&& set AI_SUPERAPP_DIAGNOSTICS=1&& node scripts/test-chatgpt-integration.mjs",
    "test:native-providers": "node scripts/test-native-providers.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "package": "npm run build && electron-builder",
    "package:portable": "npm run build && electron-builder --win portable",
    "verify:release": "node scripts/publish-update.mjs --verify-only",
    "gen-icon": "node scripts/gen-icon.mjs",
    "capture:readme": "node scripts/capture-readme-screenshots.mjs",
    "capture:readme:chat": "node scripts/capture-readme-screenshots.mjs --live-chat",
    "publish:update": "node scripts/publish-update.mjs",
    "release": "npm run package && node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "i18next": "^25.2.1",
    "lucide-react": "^1.24.0",
    "node-pty": "^1.1.0",
    "openai": "^5.8.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.16.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "brace-expansion-secure": "npm:brace-expansion@5.0.8",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "file:vendor/brace-expansion-compat"
  },
  "build": {
    "appId": "com.superapp.ai",
    "productName": "LLMelt",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JustMLC4real",
        "repo": "LLMelt",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
